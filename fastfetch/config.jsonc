{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰅂 "
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "krnl",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "up",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
